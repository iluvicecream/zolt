HOL = require("@hol");
H = HOL.el;

local content =
        H("turbo-frame")
            :id("doc-content")
            :child(
                H("h1"):class("doc-header"):child("@hol"),
                H("p"):child("hol (html on lua) is zolt's standard library for building html in luau. instead of gluing tags together by hand, you describe a tree of elements and hol renders it for you. zolt's own documentation pages are written with hol :)"),
                H("h2"):child("getting started"),
                H("p"):child("hol is embedded in zolt, so there is nothing to install. require it like any ", H("code"):child("@"), " module, and keep a short alias for ", H("code"):child("el"), ":"),
                H("pre"):child(H("code"):child("local HOL = require(\"@hol\")\nlocal H = HOL.el")),
                H("p"):child("elements and documents are luau objects, and every method returns the object it was called on. that means you can build with long chains:"),
                H("pre"):child(H("code"):child("local page = HOL.document()\n    :title(\"hello, zolt\")\n    :body(\n        H(\"h1\"):text(\"hello, world!\")\n    )\n\necho(page:render())")),
                H("h2"):child("HOL.el(tag)"),
                H("pre"):child(H("code"):child("HOL.el(tag: string) -> Node")),
                H("p"):child("creates an element node. the tag name is lowercased, so ", H("code"):child("H(\"DIV\")"), " and ", H("code"):child("H(\"div\")"), " are the same. nodes start out empty; you add attributes, classes, styles, and children with the methods below."),
                H("h2"):child("node:id(val)"),
                H("pre"):child(H("code"):child("node:id(val: string) -> node")),
                H("p"):child("sets the element's ", H("code"):child("id"), " attribute. a later call replaces the earlier value."),
                H("pre"):child(H("code"):child("H(\"h1\"):id(\"welcome\"):text(\"hi\")\n-- <h1 id=\"welcome\">hi</h1>")),
                H("h2"):child("node:class(...)"),
                H("pre"):child(H("code"):child("node:class(...class_names: (string)?) -> node")),
                H("p"):child("adds classes to the element. pass as many as you want; they accumulate across calls until the node renders. empty strings and ", H("code"):child("nil"), " are skipped."),
                H("pre"):child(H("code"):child("H(\"button\"):class(\"btn\", \"primary\"):text(\"save\")\n-- <button class=\"btn primary\">save</button>")),
                H("h2"):child("node:attr(key, value)"),
                H("pre"):child(H("code"):child("node:attr(key: string, value: string | boolean?) -> node")),
                H("p"):child("sets an attribute. string values are escaped when the node renders. pass ", H("code"):child("true"), " for a bare attribute like ", H("code"):child("required"), " or ", H("code"):child("disabled"), "; ", H("code"):child("false"), " and ", H("code"):child("nil"), " are skipped."),
                H("pre"):child(H("code"):child("H(\"input\"):attr(\"type\", \"text\"):attr(\"required\", true)\n-- <input type=\"text\" required />")),
                H("h2"):child("node:style(styles)"),
                H("pre"):child(H("code"):child("node:style(styles: StyleTable | string) -> node")),
                H("p"):child("sets inline css from a table or from a raw css string. table keys and values are joined with ", H("code"):child(":"), " and the pairs are joined with ", H("code"):child(";"), "."),
                H("pre"):child(H("code"):child("H(\"div\"):style({ color = \"red\", [\"font-size\"] = \"14px\" })\nH(\"p\"):style(\"font-weight: bold\")")),
                H("h2"):child("node:text(val)"),
                H("pre"):child(H("code"):child("node:text(val: string | number?) -> node")),
                H("p"):child("appends text to the element, escaping ", H("code"):child("&"), ", ", H("code"):child("<"), ", ", H("code"):child(">"), ", and quotes so it shows up as text instead of markup. numbers are converted to strings and ", H("code"):child("nil"), " is skipped."),
                H("pre"):child(H("code"):child("H(\"p\"):text(\"a & b\")\n-- <p>a &amp; b</p>")),
                H("h2"):child("node:raw(html)"),
                H("pre"):child(H("code"):child("node:raw(html: string?) -> node")),
                H("p"):child("appends html as-is, with no escaping. this is the one method that trusts you, so only pass markup you control:"),
                H("pre"):child(H("code"):child("H(\"p\"):raw(\"<strong>important</strong>\")")),
                H("h2"):child("node:child(...)"),
                H("pre"):child(H("code"):child("node:child(...children: NodeChild?) -> node")),
                H("p"):child("appends children. nodes render in place; strings and numbers are escaped like ", H("code"):child("text"), "; and ", H("code"):child("nil"), " and booleans are skipped. you can pass several children at once."),
                H("pre"):child(H("code"):child("H(\"div\"):child(\n    H(\"h1\"):text(\"hello\"),\n    H(\"p\"):text(\"world\")\n)")),
                H("h2"):child("node:when(condition, callback)"),
                H("pre"):child(H("code"):child("node:when(condition: any, callback: (node: Node) -> ()) -> node")),
                H("p"):child("runs ", H("code"):child("callback(node)"), " when ", H("code"):child("condition"), " is truthy. handy for classes or content that should only appear sometimes:"),
                H("pre"):child(H("code"):child("H(\"p\"):when(error_message ~= nil, function(node)\n    node:class(\"error\"):text(error_message)\nend)")),
                H("h2"):child("node:each(list, callback)"),
                H("pre"):child(H("code"):child("node:each<T>(list: { T }?, callback: (item: T, index: number) -> NodeChild?) -> node")),
                H("p"):child("iterates ", H("code"):child("list"), " and calls ", H("code"):child("callback(item, index)"), " for every entry. whatever the callback returns is appended like ", H("code"):child("child"), "; return ", H("code"):child("nil"), " to skip an entry."),
                H("pre"):child(H("code"):child("local names = { \"ada\", \"grace\", \"katherine\" }\n\nH(\"ul\"):each(names, function(name, index)\n    return H(\"li\"):text(index .. \". \" .. name)\nend)")),
                H("h2"):child("node:render()"),
                H("pre"):child(H("code"):child("node:render() -> string")),
                H("p"):child("renders the node and everything inside it to an html string. in a zolt route that string is what ", H("code"):child("echo"), " sends to the browser."),
                H("pre"):child(H("code"):child("echo(H(\"h1\"):text(\"hi\"):render())")),
                H("h2"):child("HOL.document()"),
                H("pre"):child(H("code"):child("HOL.document() -> Document")),
                H("p"):child("creates a whole html document: doctype, ", H("code"):child("html"), ", ", H("code"):child("head"), ", and ", H("code"):child("body"), ". it starts with ", H("code"):child("lang = \"en\""), " and ", H("code"):child("title = \"Untitled Page\""), "; the document methods below change that and add more to the head."),
                H("pre"):child(H("code"):child("local page = HOL.document()\n    :lang(\"en\")\n    :title(\"hello, zolt\")\n    :meta({ charset = \"utf-8\" })\n    :css(\"/asset/css/site.css\")\n    :js(\"/asset/js/app.js\", { type = \"module\" })\n    :body(\n        H(\"main\"):child(\n            H(\"h1\"):text(\"hello, world!\")\n        )\n    )")),
                H("h2"):child("document methods"),
                H("p"):child("all document methods return the document so you can keep chaining:"),
                H("pre"):child(H("code"):child(":lang(lang: string) -> Document         -- <html lang=\"...\">\n:title(title: string) -> Document     -- the <title>\n:meta(attrs: Attributes) -> Document  -- one <meta> tag\n:css(href: string) -> Document        -- <link rel=\"stylesheet\">\n:js(src: string, attrs: Attributes?) -> Document -- a <script> tag\n:body(...children: NodeChild?) -> Document -- appended to <body>\n:render() -> string                   -- the whole page")),
                H("p"):child("for example, ", H("code"):child(":js(\"/app.js\", { type = \"module\" })"), " adds ", H("code"):child("type=\"module\""), " to the script tag. call ", H("code"):child(":body"), " as many times as you like; each call appends more children to ", H("code"):child("<body>"), "."),
                H("h2"):child("escaping and notes"),
                H("p"):child("text, children, and attribute values are escaped for you by default. only ", H("code"):child(":raw()"), " writes markup untouched, and style strings are passed through as css."),
                H("p"):child("void tags (", H("code"):child("meta"), ", ", H("code"):child("link"), ", ", H("code"):child("img"), ", ", H("code"):child("input"), ", ", H("code"):child("br"), ", ", H("code"):child("hr"), ", and friends) render self-closed, like ", H("code"):child("<input ... />"), ", and ignore children."),
                H("p"):child("see also ", H("a"):attr("href", "/doc/ref/echo.luau"):child("echo"), ", the request/response reference, and the ", H("a"):attr("href", "/doc/intro.luau"):child("introduction"), " if you're new around here.")
            )

echo(content:render())
